rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }
    // Quyền quản trị lấy từ hồ sơ thật ở mỗi request; UI không thể tự cấp quyền.
    function staff() {
      return request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.id == request.auth.uid
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('status', 'active') == 'active'
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', 'user') in ['admin', 'moderator'];
    }
    function administrator() {
      return staff() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    function validProfile(uid) {
      let d = request.resource.data;
      return d.keys().hasAll(['id', 'name', 'handle', 'bio', 'showBio', 'cookedCount', 'createdAt', 'updatedAt'])
        && d.keys().hasOnly(['schemaVersion', 'id', 'name', 'handle', 'bio', 'showBio', 'cookedCount', 'createdAt', 'updatedAt', 'avatarUrl', 'role', 'status', 'lastLoginAt', 'lockedAt', 'lockReason'])
        && d.id == uid
        && d.name is string && d.name.size() > 0 && d.name.size() <= 60
        && d.handle is string && d.handle.size() > 0 && d.handle.size() <= 132
        && d.bio is string && d.bio.size() <= 200
        && d.showBio is bool && d.cookedCount is int && d.cookedCount >= 0
        && d.createdAt is timestamp && d.updatedAt == request.time
        && d.get('schemaVersion', 0) in [0, 1]
        && d.get('role', 'user') in ['user', 'moderator', 'admin']
        && d.get('status', 'active') in ['active', 'locked']
        && (d.get('lastLoginAt', null) == null || d.lastLoginAt is timestamp)
        && (d.get('avatarUrl', null) == null || (d.avatarUrl is string && d.avatarUrl.size() <= 2048 && d.avatarUrl.matches('https://[^ /]+(/.*)?')))
        && ((d.get('status', 'active') == 'active' && d.get('lockedAt', null) == null && d.get('lockReason', null) == null)
          || (d.get('status', 'active') == 'locked' && d.lockedAt is timestamp
            && (d.get('lockReason', null) == null || (d.lockReason is string && d.lockReason.size() <= 500))));
    }
    function activeAccount(uid) {
      return owner(uid) && (!exists(/databases/$(database)/documents/users/$(uid))
        || get(/databases/$(database)/documents/users/$(uid)).data.get('status', 'active') == 'active');
    }
    // Hồ sơ riêng không được dùng làm hồ sơ công khai; tránh lộ thông tin qua truy vấn collection.
    match /users/{uid} {
      allow get: if owner(uid) || staff();
      allow list: if administrator();
      allow delete: if false;
      allow create: if owner(uid) && validProfile(uid)
        && request.resource.data.schemaVersion == 1
        && request.resource.data.role == 'user'
        && request.resource.data.status == 'active'
        && request.resource.data.cookedCount == 0
        && request.resource.data.createdAt == request.time;
      allow update: if activeAccount(uid) && validProfile(uid)
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['name', 'bio', 'showBio', 'updatedAt']);
      // Không cho tự sửa quyền/khóa chính mình để luôn giữ một admin đang hoạt động.
      allow update: if administrator() && request.auth.uid != uid && validProfile(uid)
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['role', 'status', 'lockedAt', 'lockReason', 'updatedAt'])
        && (request.resource.data.status != 'locked'
          || (request.resource.data.lockedAt == request.time
            && request.resource.data.lockReason is string
            && request.resource.data.lockReason.size() > 0));

      match /favorites/{recipeId} {
        allow read, delete: if activeAccount(uid);
        allow create, update: if activeAccount(uid)
          && request.resource.data.keys().hasOnly(['recipeId', 'createdAt'])
          && request.resource.data.recipeId == recipeId
          && request.resource.data.createdAt == request.time;
      }
      // Chỉ lưu dấu đã đọc; nội dung thông báo luôn lấy từ kết quả duyệt thật.
      match /notification_reads/{notificationId} {
        allow read: if activeAccount(uid);
        allow create, update: if activeAccount(uid)
          && notificationId.size() <= 160
          && request.resource.data.keys().hasOnly(['readAt'])
          && request.resource.data.readAt == request.time;
        allow delete: if false;
      }
      match /fridge/{fridgeId} {
        allow get: if activeAccount(uid);
        allow list, delete: if false;
        allow create, update: if activeAccount(uid)
          && exists(/databases/$(database)/documents/users/$(uid))
          && fridgeId == 'current'
          && request.resource.data.keys().hasAll(['schemaVersion', 'ingredientIds', 'updatedAt'])
          && request.resource.data.keys().hasOnly(['schemaVersion', 'ingredientIds', 'updatedAt'])
          && request.resource.data.schemaVersion == 1
          && request.resource.data.ingredientIds is map
          && request.resource.data.ingredientIds.size() <= 500
          && request.resource.data.ingredientIds.values().toSet().hasOnly([true])
          && request.resource.data.updatedAt == request.time;
      }
      match /recipe_drafts/{draftId} {
        allow read: if activeAccount(uid);
        allow create, update: if activeAccount(uid) && draftId == 'current'
          && request.resource.data.keys().hasAll(['schemaVersion','authorId','submissionId','revision','draft','updatedAt','revisionOf'])
          && request.resource.data.keys().hasOnly(['schemaVersion','authorId','submissionId','revision','draft','updatedAt','revisionOf'])
          && request.resource.data.schemaVersion == 1 && request.resource.data.authorId == uid
          && request.resource.data.submissionId is string && request.resource.data.submissionId.size() <= 64
          && request.resource.data.revision is int && request.resource.data.revision >= 0
          && (request.resource.data.draft == null || request.resource.data.draft is map)
          && request.resource.data.updatedAt == request.time;
        allow delete: if activeAccount(uid);
      }
    }
    function chatMember(data) {
      return request.auth != null && activeAccount(request.auth.uid)
        && request.auth.uid in data.memberIds;
    }
    function chatCreate() {
      let d = request.resource.data;
      let uid = request.auth.uid;
      let peer = d.memberIds[0] == uid ? d.memberIds[1] : d.memberIds[0];
      let recipe = get(/databases/$(database)/documents/recipes/$(d.recipeId)).data;
      return d.keys().hasAll(['memberIds','memberNames','recipeId','createdAt','updatedAt','lastMessageId','lastMessageText','lastSenderId','readAt'])
        && d.keys().hasOnly(['memberIds','memberNames','recipeId','createdAt','updatedAt','lastMessageId','lastMessageText','lastSenderId','readAt'])
        && d.memberIds is list && d.memberIds.size() == 2
        && d.memberIds.toSet().size() == 2 && uid in d.memberIds
        && d.memberNames is map && d.memberNames.keys().hasOnly(d.memberIds)
        && d.memberNames.keys().hasAll(d.memberIds)
        && exists(/databases/$(database)/documents/users/$(peer))
        && get(/databases/$(database)/documents/users/$(peer)).data.get('status', 'active') == 'active'
        && d.memberNames[uid] == get(/databases/$(database)/documents/users/$(uid)).data.name
        && recipe.status == 'approved' && recipe.authorId == peer
        && recipe.author.id == peer && d.memberNames[peer] == recipe.author.name
        && d.createdAt == request.time && d.updatedAt == request.time
        && d.lastMessageId == null && d.lastMessageText == '' && d.lastSenderId == null
        && d.readAt is map && d.readAt.keys().hasOnly([uid]) && d.readAt[uid] == request.time;
    }
    function ownReadUpdate() {
      let uid = request.auth.uid;
      return request.resource.data.readAt is map
        && request.resource.data.readAt.diff(resource.data.readAt).affectedKeys().hasOnly([uid])
        && request.resource.data.readAt[uid] == request.time;
    }
    function chatSend(conversationId) {
      let d = request.resource.data;
      let messagePath = /databases/$(database)/documents/conversations/$(conversationId)/messages/$(d.lastMessageId);
      let message = getAfter(messagePath).data;
      return d.diff(resource.data).affectedKeys()
          .hasOnly(['lastMessageId','lastMessageText','lastSenderId','updatedAt','readAt'])
        && d.lastMessageId is string && d.lastMessageId.matches('[a-f0-9]{32}')
        && !exists(messagePath)
        && d.updatedAt == request.time && d.lastSenderId == request.auth.uid
        && message.senderId == request.auth.uid && message.createdAt == request.time
        && d.lastMessageText == (message.get('image', null) != null && message.text == '' ? '📷 Ảnh' : message.text);
    }
    match /conversations/{conversationId} {
      // Transaction tạo hội thoại cần đọc document chưa tồn tại; nội dung thật
      // chỉ được đọc bởi thành viên, không mở quyền liệt kê hồ sơ người dùng.
      allow get: if request.auth != null && activeAccount(request.auth.uid)
        && (resource == null || chatMember(resource.data));
      allow list: if chatMember(resource.data);
      allow create: if request.auth != null && activeAccount(request.auth.uid)
        && conversationId.matches('[a-f0-9]{64}') && chatCreate();
      allow update: if chatMember(resource.data) && ownReadUpdate()
        && (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readAt'])
          || chatSend(conversationId));
      allow delete: if false;
      match /messages/{messageId} {
        function parentMember() {
          return chatMember(get(/databases/$(database)/documents/conversations/$(conversationId)).data);
        }
        allow read: if parentMember();
        allow create: if parentMember()
          && messageId.matches('[a-f0-9]{32}')
          && request.resource.data.keys().hasAll(['senderId','text','createdAt'])
          && request.resource.data.keys().hasOnly(['senderId','text','createdAt','image'])
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 2000
          && (request.resource.data.text.size() > 0 || request.resource.data.get('image', null) != null)
          && (request.resource.data.text == '' || !request.resource.data.text.matches('[ \\t\\n\\r]*'))
          && (request.resource.data.get('image', null) == null
            || (cloudinaryImage(request.resource.data.image)
              && request.resource.data.image.id.size() <= 128
              && request.resource.data.image.name.size() <= 120))
          && request.resource.data.createdAt == request.time
          && getAfter(/databases/$(database)/documents/conversations/$(conversationId)).data.lastMessageId == messageId
          && getAfter(/databases/$(database)/documents/conversations/$(conversationId)).data.lastSenderId == request.auth.uid
          && getAfter(/databases/$(database)/documents/conversations/$(conversationId)).data.updatedAt == request.time;
        allow update, delete: if false;
      }
    }
    function cloudinaryImage(image) {
      return image is map && image.keys().hasOnly(['id','name','url','publicId'])
        && image.keys().hasAll(['id','name','url','publicId'])
        && image.id is string && image.name is string
        && image.url is string && image.url.size() <= 2048
        && image.url.matches('https://res[.]cloudinary[.]com/ddqouziau/image/upload/.*')
        && image.publicId is string && image.publicId.size() > 0 && image.publicId.size() <= 500;
    }
    function recipeContent(c) {
      return c is map
        && c.keys().hasAll(['title','description','cover','preparationMinutes','cookingMinutes','servings','difficulty','meals','categories','storageNotes','ingredientGroups','ingredients','steps'])
        && c.keys().hasOnly(['isBanner','title','description','cover','preparationMinutes','cookingMinutes','servings','difficulty','meals','categories','storageNotes','ingredientGroups','ingredients','steps'])
        && c.get('isBanner', false) == false
        && c.title is string && c.title.size() > 0 && c.title.size() <= 80
        && c.description is string && c.description.size() <= 500
        && c.storageNotes is string && c.storageNotes.size() <= 500
        && cloudinaryImage(c.cover)
        && c.preparationMinutes is int && c.preparationMinutes >= 0 && c.preparationMinutes <= 240
        && c.cookingMinutes is int && c.cookingMinutes >= 1 && c.cookingMinutes <= 720
        && c.servings is int && c.servings >= 1 && c.servings <= 50
        && c.difficulty in ['easy','medium','hard']
        && c.meals is list && c.meals.size() <= 6
        && c.categories is list && c.categories.size() <= 12
        && c.ingredientGroups is list && c.ingredientGroups.size() >= 1 && c.ingredientGroups.size() <= 8
        && c.ingredients is list && c.ingredients.size() >= 1 && c.ingredients.size() <= 30
        && c.steps is list && c.steps.size() >= 1 && c.steps.size() <= 20;
    }
    match /recipes/{submissionId} {
      allow get: if resource == null || resource.data.status == 'approved' || (request.auth != null && resource.data.authorId == request.auth.uid) || staff();
      allow list: if resource.data.status == 'approved' || (request.auth != null && resource.data.authorId == request.auth.uid) || staff();
      allow create: if request.auth != null && activeAccount(request.auth.uid)
        && request.resource.data.keys().hasAll(['author','isBanner','schemaVersion','id','authorId','status','content','contentHash','catalogVersion','submittedAt','reviewedAt','reviewedBy','reviewReason','revisionOf'])
        && request.resource.data.keys().hasOnly(['author','isBanner','schemaVersion','id','authorId','status','content','contentHash','catalogVersion','submittedAt','reviewedAt','reviewedBy','reviewReason','revisionOf'])
        && request.resource.data.schemaVersion == 2 && request.resource.data.id == submissionId
        && request.resource.data.authorId == request.auth.uid && request.resource.data.status == 'pending'
        && request.resource.data.isBanner == false
        && request.resource.data.author is map
        && request.resource.data.author.keys().hasOnly(['id','name','handle'])
        && request.resource.data.author.id == request.auth.uid
        && request.resource.data.author.name == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.name
        && request.resource.data.author.handle == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.handle
        && request.resource.data.contentHash is string && request.resource.data.contentHash.size() == 64
        && request.resource.data.catalogVersion is string
        && (request.resource.data.revisionOf == null || (request.resource.data.revisionOf is string
          && get(/databases/$(database)/documents/recipes/$(request.resource.data.revisionOf)).data.authorId == request.auth.uid
          && get(/databases/$(database)/documents/recipes/$(request.resource.data.revisionOf)).data.status == 'rejected'))
        && request.resource.data.submittedAt == request.time
        && request.resource.data.reviewedAt == null && request.resource.data.reviewedBy == null && request.resource.data.reviewReason == null
        && recipeContent(request.resource.data.content);
      // Bài đã gửi giữ nguyên nội dung; chỉ duyệt một lần và ghi audit trong cùng commit.
      allow update: if staff() && reviewUpdate(submissionId);
      allow update: if administrator() && resource.data.status == 'approved'
        && request.resource.data.status == 'approved'
        && request.resource.data.isBanner is bool
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isBanner']);
      allow update: if recipeVisibilityUpdate(submissionId);
      // Xóa khỏi app bằng tombstone để không mất audit và các đánh giá liên quan.
      allow delete: if false;
    }
    function recipeVisibilityUpdate(id) {
      let d = request.resource.data;
      let before = resource.data;
      let eventPath = /databases/$(database)/documents/recipes/$(id)/visibility_events/$(d.visibilityEventId);
      let e = getAfter(eventPath).data;
      return request.auth != null && before.schemaVersion == 2
        && d.diff(before).affectedKeys().hasOnly(['status', 'isBanner', 'visibilityEventId', 'visibilityActor', 'visibilityRole', 'visibilityReason', 'visibilityAt'])
        && d.isBanner == false && d.visibilityAt == request.time
        && d.visibilityEventId is string && d.visibilityEventId.size() > 0 && d.visibilityEventId.size() <= 128
        && !exists(eventPath) && e.actor == request.auth.uid
        && e.role == d.visibilityRole && e.reason == d.visibilityReason
        && e.fromStatus == before.status && e.toStatus == d.status && e.createdAt == request.time
        && d.visibilityActor == request.auth.uid
        && ((activeAccount(before.authorId) && d.visibilityRole == 'author' && d.visibilityReason == null
            && ((before.status == 'approved' && d.status == 'hidden')
              || (before.status == 'hidden' && before.visibilityRole == 'author' && d.status == 'approved')
              || (before.status in ['pending', 'approved', 'rejected', 'hidden'] && d.status == 'deleted')))
          || (administrator() && d.visibilityRole == 'admin'
            && ((d.status == 'hidden' && (before.status == 'approved'
                  || (before.status == 'hidden' && before.visibilityRole == 'author'))
                && d.visibilityReason is string && d.visibilityReason.size() > 0 && d.visibilityReason.size() <= 500
                && !d.visibilityReason.matches('[ \\t\\n\\r]*'))
              || (before.status == 'hidden' && before.visibilityRole == 'admin'
                && d.status == 'approved' && d.visibilityReason == null))));
    }
    match /recipes/{id}/visibility_events/{eventId} {
      allow read: if staff() || (request.auth != null
        && get(/databases/$(database)/documents/recipes/$(id)).data.authorId == request.auth.uid);
      allow create: if request.auth != null
        && request.resource.data.keys().hasAll(['actor', 'role', 'reason', 'fromStatus', 'toStatus', 'createdAt'])
        && request.resource.data.keys().hasOnly(['actor', 'role', 'reason', 'fromStatus', 'toStatus', 'createdAt'])
        && getAfter(/databases/$(database)/documents/recipes/$(id)).data.visibilityEventId == eventId
        && recipeVisibilityEvent(id);
      allow update, delete: if false;
    }
    function recipeVisibilityEvent(id) {
      let before = get(/databases/$(database)/documents/recipes/$(id)).data;
      let after = getAfter(/databases/$(database)/documents/recipes/$(id)).data;
      let e = request.resource.data;
      return before.get('visibilityEventId', null) != after.visibilityEventId
        && e.actor == request.auth.uid && after.visibilityActor == request.auth.uid
        && e.role == after.visibilityRole && e.reason == after.visibilityReason
        && e.fromStatus == before.status && e.toStatus == after.status
        && e.createdAt == request.time && after.visibilityAt == request.time
        && ((activeAccount(before.authorId) && e.role == 'author') || (administrator() && e.role == 'admin'));
    }
    function validReviewReason(d) {
      return (d.reviewReason == null && d.status == 'approved')
        || (d.reviewReason is string && d.reviewReason.size() > 0
          && d.reviewReason.size() <= 500 && !d.reviewReason.matches('[ \\t\\n\\r]*'));
    }
    function reviewUpdate(id) {
      let d = request.resource.data;
      let e = getAfter(/databases/$(database)/documents/recipe_moderation_events/$(id)).data;
      return resource.data.schemaVersion == 2 && resource.data.status == 'pending'
        && d.status in ['approved', 'rejected'] && d.reviewedAt == request.time
        && d.reviewedBy == request.auth.uid && validReviewReason(d)
        && d.diff(resource.data).affectedKeys().hasOnly(['status', 'reviewedAt', 'reviewedBy', 'reviewReason'])
        && !exists(/databases/$(database)/documents/recipe_moderation_events/$(id))
        && e.submissionId == id && e.authorId == resource.data.authorId
        && e.decision == (d.status == 'approved' ? 'approve' : 'reject')
        && e.reviewer == request.auth.uid && e.reason == d.reviewReason && e.createdAt == request.time
        && (d.status == 'rejected'
          || (get(/databases/$(database)/documents/users/$(resource.data.authorId)).data.get('status', 'active') == 'active'
            && get(/databases/$(database)/documents/users/$(resource.data.authorId)).data.id == resource.data.authorId
            && recipeContent(d.content)));
    }
    match /recipe_moderation_events/{id} {
      allow read: if staff();
      allow create: if staff() && validReviewEvent(id);
      allow update, delete: if false;
    }
    function validReviewEvent(id) {
      let e = request.resource.data;
      let before = get(/databases/$(database)/documents/recipes/$(id)).data;
      let after = getAfter(/databases/$(database)/documents/recipes/$(id)).data;
      return e.keys().hasAll(['submissionId', 'authorId', 'decision', 'reviewer', 'reason', 'createdAt'])
        && e.keys().hasOnly(['submissionId', 'authorId', 'decision', 'reviewer', 'reason', 'createdAt'])
        && before.status == 'pending' && after.status in ['approved', 'rejected']
        && e.submissionId == id && e.authorId == before.authorId
        && e.decision == (after.status == 'approved' ? 'approve' : 'reject')
        && after.reviewedBy == request.auth.uid && e.reviewer == request.auth.uid
        && e.reason == after.reviewReason && validReviewReason(after)
        && e.createdAt == request.time && after.reviewedAt == request.time;
    }
    // Danh mục công khai; admin phát hành phiên bản mới, bootstrap ban đầu vẫn qua IAM.
    match /catalogs/ingredients {
      allow get: if true;
      allow list, create, delete: if false;
      allow update: if administrator()
        && request.resource.data.keys().hasAll(['schemaVersion', 'version', 'locale', 'categories', 'units', 'ingredients', 'contentHash', 'updatedAt'])
        && request.resource.data.keys().hasOnly(['schemaVersion', 'version', 'locale', 'categories', 'units', 'ingredients', 'contentHash', 'updatedAt'])
        && request.resource.data.schemaVersion == 1 && request.resource.data.locale == 'vi-VN'
        && request.resource.data.version is string
        && request.resource.data.version.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}[.]v[0-9]+')
        && request.resource.data.version != resource.data.version
        && request.resource.data.categories is list && request.resource.data.categories.size() > 0
        && request.resource.data.units is list && request.resource.data.units.size() > 0
        && request.resource.data.ingredients is list && request.resource.data.ingredients.size() > 0
        && request.resource.data.contentHash is string && request.resource.data.contentHash.matches('[a-f0-9]{64}')
        && request.resource.data.updatedAt == request.time;
    }
    function kitchenOwner(uid) {
      return activeAccount(uid) && exists(/databases/$(database)/documents/users/$(uid));
    }
    function shortText(value, max) {
      return value is string && value.size() > 0 && value.size() <= max;
    }
    function calendarDay(value) {
      return value is string && value.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}');
    }
    function recipeReference(value) {
      return value is map && value.keys().hasAll(['id', 'title', 'authorId'])
        && value.keys().hasOnly(['id', 'title', 'authorId'])
        && shortText(value.id, 128) && shortText(value.title, 80)
        && value.authorId is string && value.authorId.size() <= 128;
    }
    function kitchenDocument(d, fields) {
      return d.keys().hasAll(fields.concat(['schemaVersion', 'updatedAt']))
        && d.keys().hasOnly(fields.concat(['schemaVersion', 'updatedAt']))
        && d.schemaVersion == 1 && d.updatedAt == request.time;
    }
    function validKitchenEntry(kind, id, d) {
      return (kind == 'meal_plans'
          && kitchenDocument(d, ['day', 'slot', 'recipe', 'servings'])
          && calendarDay(d.day) && d.slot in ['breakfast', 'lunch', 'dinner']
          && recipeReference(d.recipe) && d.servings is int && d.servings >= 1 && d.servings <= 50)
        || (kind == 'recipe_collections' && kitchenDocument(d, ['name', 'recipeIds'])
          && shortText(d.name, 60) && d.recipeIds is map && d.recipeIds.size() <= 100
          && d.recipeIds.values().toSet().hasOnly([true]))
        || (kind == 'cooking_logs' && kitchenDocument(d, ['recipe', 'day', 'servings', 'note'])
          && recipeReference(d.recipe) && calendarDay(d.day)
          && d.servings is int && d.servings >= 1 && d.servings <= 50
          && d.note is string && d.note.size() <= 1000)
        || (kind == 'pantry_lots' && kitchenDocument(d, ['ingredientId', 'name', 'amount', 'unitId', 'expiresOn'])
          && shortText(d.ingredientId, 128) && shortText(d.name, 80)
          && ((d.amount == null && d.unitId == null)
            || (d.amount is number && d.amount >= 0 && d.amount <= 1000000 && shortText(d.unitId, 128)))
          && (d.expiresOn == null || calendarDay(d.expiresOn)))
        || (kind == 'following' && kitchenDocument(d, ['name']) && shortText(d.name, 60)
          && id != request.auth.uid
          && exists(/databases/$(database)/documents/users/$(id))
          && get(/databases/$(database)/documents/users/$(id)).data.get('status', 'active') == 'active');
    }
    match /users/{uid}/{kind}/{id} {
      allow read, delete: if kind in ['meal_plans', 'recipe_collections', 'cooking_logs', 'pantry_lots', 'following'] && kitchenOwner(uid);
      allow create, update: if kind in ['meal_plans', 'recipe_collections', 'cooking_logs', 'pantry_lots', 'following']
        && kitchenOwner(uid) && shortText(id, 128) && validKitchenEntry(kind, id, request.resource.data);
    }
    function publicRecipe(id) {
      return get(/databases/$(database)/documents/recipes/$(id)).data.status == 'approved';
    }
    function score(d) { return d.get('status', '') == 'approved' ? d.stars : 0; }
    // Điểm tổng phải đi cùng đúng một đánh giá thay đổi; không tin delta do client tự gửi.
    function ratingDelta(recipeId, reviewerId) {
      let reviewPath = /databases/$(database)/documents/recipes/$(recipeId)/user_reviews/$(reviewerId);
      let ratingPath = /databases/$(database)/documents/recipes/$(recipeId)/ratings/summary;
      let before = exists(reviewPath) ? get(reviewPath).data : {};
      let after = existsAfter(reviewPath) ? getAfter(reviewPath).data : {};
      let old = exists(ratingPath) ? get(ratingPath).data : {'sum': 0, 'count': 0};
      let result = getAfter(ratingPath).data;
      return result.keys().hasAll(['sum', 'count', 'lastReviewerId', 'updatedAt'])
        && result.keys().hasOnly(['sum', 'count', 'lastReviewerId', 'updatedAt'])
        && result.updatedAt == request.time && result.lastReviewerId == reviewerId
        && result.sum is int && result.count is int && result.count >= 0
        && result.sum >= result.count && result.sum <= result.count * 5
        && result.sum == old.sum + score(after) - score(before)
        && result.count == old.count + (score(after) > 0 ? 1 : 0) - (score(before) > 0 ? 1 : 0)
        && ((existsAfter(reviewPath) && after.updatedAt == request.time
            && (!exists(reviewPath) || after != before))
          || (exists(reviewPath) && !existsAfter(reviewPath)));
    }
    function reviewBody(uid, d) {
      return d.keys().hasAll(['uid', 'name', 'stars', 'body', 'status', 'updatedAt'])
        && d.keys().hasOnly(['uid', 'name', 'stars', 'body', 'status', 'updatedAt'])
        && d.uid == uid && shortText(d.name, 60)
        && d.stars is int && d.stars >= 1 && d.stars <= 5
        && d.body is string && d.body.size() <= 1000 && d.updatedAt == request.time;
    }
    match /recipes/{recipeId}/user_reviews/{reviewerId} {
      allow get: if staff() || (request.auth != null && kitchenOwner(reviewerId))
        || (publicRecipe(recipeId) && resource.data.status == 'approved');
      allow list: if staff() || (publicRecipe(recipeId) && resource.data.status == 'approved');
      allow create, update: if kitchenOwner(reviewerId) && publicRecipe(recipeId)
        && get(/databases/$(database)/documents/recipes/$(recipeId)).data.authorId != reviewerId
        && reviewBody(reviewerId, request.resource.data) && request.resource.data.status == 'pending'
        && request.resource.data.name == get(/databases/$(database)/documents/users/$(reviewerId)).data.name
        && ratingDelta(recipeId, reviewerId);
      allow update: if staff() && publicRecipe(recipeId) && reviewBody(reviewerId, request.resource.data)
        && request.resource.data.status in ['approved', 'hidden']
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
        && request.resource.data.status != resource.data.status && ratingDelta(recipeId, reviewerId);
      allow delete: if kitchenOwner(reviewerId) && ratingDelta(recipeId, reviewerId);
      match /reports/{uid} {
        allow read: if staff();
        allow create, update: if kitchenOwner(uid) && uid != reviewerId && publicRecipe(recipeId)
          && get(/databases/$(database)/documents/recipes/$(recipeId)/user_reviews/$(reviewerId)).data.status == 'approved'
          && request.resource.data.keys().hasAll(['reason', 'updatedAt'])
          && request.resource.data.keys().hasOnly(['reason', 'updatedAt'])
          && shortText(request.resource.data.reason, 500) && request.resource.data.updatedAt == request.time;
      }
    }
    match /recipes/{recipeId}/ratings/{id} {
      allow get: if id == 'summary' && (publicRecipe(recipeId) || staff());
      allow create, update: if id == 'summary' && request.auth != null
        && (kitchenOwner(request.resource.data.lastReviewerId) || staff())
        && ratingDelta(recipeId, request.resource.data.lastReviewerId);
    }
    match /user_review_moderation_events/{id} {
      allow read: if staff();
      // Công cụ IAM ghi audit cùng giao dịch duyệt; client không tự tạo hay sửa lịch sử.
      allow write: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
